# ============================================================================
# Copy to .env and fill in. run.sh loads this file automatically.
# Never commit .env - it is gitignored.
#
# Every variable without a documented default is REQUIRED: the application
# fails fast at startup rather than running with a placeholder.
# ============================================================================

# --- Database ---------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/learnnow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- Security ---------------------------------------------------------------
# Minimum 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Google Sign-In ---------------------------------------------------------
# Required. Enforced as the ID token audience; sign-in is refused without it.
GOOGLE_CLIENT_ID=

# --- Transactional email (Resend) -------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook secret from the Razorpay dashboard; required to accept webhooks.
RAZORPAY_WEBHOOK_SECRET=

# --- URLs -------------------------------------------------------------------
# Public frontend origin, used to build links in outbound email.
APP_BASE_URL=http://localhost:5173
# Comma-separated exact origins. Wildcards are rejected at startup.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Local development only -------------------------------------------------
# Accepts payment signatures without verification. Local profile only.
PAYMENTS_MOCK_ENABLED=true
SHOW_SQL=false
